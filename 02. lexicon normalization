import nltk

nltk.download('wordnet')
nltk.download('omw-1.4')
nltk.download('averaged_perceptron_tagger')
nltk.download('maxent_ne_chunker')
nltk.download('words')

from nltk.stem import PorterStemmer, WordNetLemmatizer
from nltk import pos_tag, ne_chunk

text = "Ratan Tata founded Tata Group in India and he is leading business growth"

print("INPUT TEXT:")
print(text)

# SAFE TOKENIZATION
tokens = text.split()
print("\nTOKENS:")
print(tokens)

# STEMMING
stemmer = PorterStemmer()
print("\nSTEMMING:")
print([stemmer.stem(w) for w in tokens])

# LEMMATIZATION
lemmatizer = WordNetLemmatizer()
print("\nLEMMATIZATION:")
print([lemmatizer.lemmatize(w) for w in tokens])

# POS TAGGING (NOW FIXED)
pos_tags = pos_tag(tokens)
print("\nPOS TAGGING:")
print(pos_tags)

# NER
print("\nNER:")
print(ne_chunk(pos_tags))
