from PyPDF2 import PdfReader
import re

file = r"C:\Users\abc\OneDrive\Desktop\file1.pdf"

reader = PdfReader(file)
text = ""

# extract text safely
for page in reader.pages:
    page_text = page.extract_text()
    if page_text:
        text += page_text.replace("\n", " ") + " "

# normalize text
text = text.lower()

# split sentences properly
sentences = re.split(r'[.!?]', text)

print("Sentences with Initiatives:\n")

count = 0

for s in sentences:
    s = s.strip()
    if "initiative" in s:
        print(s)
        count += 1

print("\nTotal Sentences Found:", count)
